{
	"manifest_version": 3,
	"name": "LinkedIn Unfollower",
	"description": "LinkedIn Unfollow People...",
	"version": "1.1.6",
	"minimum_chrome_version": "88",
	"incognito": "split",
	"icons": {
		"128": "images/icon.png"
	},
	"action": {
		"default_icon": "images/icon.png",
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": [
		"storage",
		"tabs",
		"activeTab",
		"identity",
		"webNavigation",
		"contextMenus",
		"notifications",
		"scripting"
	],
	"host_permissions": [
		"*://*.linkedin.com/*"
	],
	"web_accessible_resources": [
		{
			"resources": [ "script.js", "images/loading.gif" ],
			"matches": [ "*://*.linkedin.com/*" ]
		}
	]
}
